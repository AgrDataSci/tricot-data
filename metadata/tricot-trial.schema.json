{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AgrDataSci/tricot-data/blob/main/metadata/tricot-trial.schema.json",
  "title": "tricot trial file",
  "description": "One tricot trial, as published in data/<crop>-<study_id>.json. Field definitions are in metadata/data-dictionary.csv.",
  "type": "object",
  "required": ["metadata", "block_data", "plot_data"],
  "additionalProperties": false,
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "block_data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["block_id"],
        "properties": {
          "block_id": { "type": "string", "pattern": "^[0-9a-f]{12}-.+$" },
          "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
          "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 }
        },
        "additionalProperties": true
      }
    },
    "plot_data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["block_id", "plot", "genotype_name", "collection_moment", "trait", "value", "value_type"],
        "additionalProperties": false,
        "properties": {
          "block_id": { "type": "string" },
          "plot": { "type": ["string", "integer"] },
          "genotype_name": { "type": "string" },
          "collection_moment": { "type": "string" },
          "trait": { "type": "string" },
          "value": { "type": ["string", "number", "null"] },
          "value_type": { "$ref": "#/$defs/value_type" }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "value_type": {
      "enum": ["rank", "integer", "decimal", "date", "datetime", "text", "select one", "select all that apply"]
    },
    "metadata": {
      "type": "object",
      "required": ["changelog", "identifier", "license", "publication_year", "study", "date", "geoLocation",
                   "data_producer", "crop", "participants", "genotypes", "variables", "funder"],
      "additionalProperties": false,
      "properties": {
        "changelog": {
          "type": "object",
          "required": ["version", "notes", "software"],
          "properties": {
            "version": { "type": "string" },
            "notes": { "type": "string" },
            "software": {
              "type": "object",
              "required": ["package", "package_version"],
              "properties": {
                "package": { "type": "string" },
                "package_version": { "type": "string" }
              }
            }
          }
        },
        "identifier": { "type": "string", "format": "uri", "pattern": "^https://doi\\.org/" },
        "license": { "type": "string", "format": "uri" },
        "publication_year": { "type": "string", "pattern": "^\\d{4}$" },
        "study": {
          "type": "object",
          "required": ["id", "country", "title", "description", "type", "unit_of_analysis", "objective", "experimental_site"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
            "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "type": { "type": "string" },
            "unit_of_analysis": { "type": "string" },
            "objective": { "type": "string" },
            "experimental_site": { "type": "string" }
          }
        },
        "date": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/date" },
            "end": { "$ref": "#/$defs/date" }
          }
        },
        "geoLocation": {
          "type": "object",
          "required": ["boundingBox"],
          "properties": {
            "boundingBox": {
              "type": "object",
              "required": ["xmin", "xmax", "ymin", "ymax"],
              "properties": {
                "xmin": { "type": "number" },
                "xmax": { "type": "number" },
                "ymin": { "type": "number" },
                "ymax": { "type": "number" }
              }
            }
          }
        },
        "data_producer": {
          "type": "object",
          "required": ["name", "identifier", "principal_investigator", "email", "program"],
          "properties": {
            "name": { "type": "string" },
            "identifier": { "type": "string" },
            "principal_investigator": { "type": "string" },
            "email": { "type": "string" },
            "program": { "type": "string" }
          }
        },
        "crop": {
          "type": "object",
          "required": ["name", "taxon"],
          "properties": {
            "name": { "type": "string" },
            "taxon": { "type": "string" }
          }
        },
        "participants": {
          "type": "object",
          "required": ["total", "men", "women"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "men": { "type": "integer", "minimum": 0 },
            "women": { "type": "integer", "minimum": 0 }
          }
        },
        "funder": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["funderName", "funderIdentifier", "awardTitle"],
            "additionalProperties": false,
            "properties": {
              "funderName": { "type": "string" },
              "funderIdentifier": { "type": "string" },
              "awardTitle": { "type": "string" },
              "awardNumber": { "type": ["string", "number"] }
            }
          }
        },
        "genotypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["genotype_name", "role"],
            "additionalProperties": false,
            "properties": {
              "genotype_name": { "type": "string" },
              "role": { "type": "string" },
              "release_year": { "type": ["string", "integer"] },
              "crossing_year": { "type": ["string", "integer"] },
              "target_trait": { "type": "string" },
              "origin": { "type": "string" },
              "remarks": { "type": "string" }
            }
          }
        },
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["variable_name", "description", "ontology_id", "value_type", "controlled_vocabulary"],
            "additionalProperties": false,
            "properties": {
              "variable_name": { "type": "string" },
              "description": { "type": "string" },
              "ontology_id": { "type": "string" },
              "value_type": { "$ref": "#/$defs/value_type" },
              "controlled_vocabulary": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
